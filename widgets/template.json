{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "Up next", "weight": "Bolder", "size": "Medium" }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "Center",
          "items": [
            { "type": "TextBlock", "text": "${progress}", "isSubtle": true, "size": "Small", "horizontalAlignment": "Right" }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "$when": "${empty}",
      "text": "${emptyText}",
      "wrap": true,
      "isSubtle": true,
      "spacing": "Medium"
    },
    {
      "type": "Container",
      "$data": "${items}",
      "separator": true,
      "spacing": "Small",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "selectAction": { "type": "Action.OpenUrl", "url": "${url}", "tooltip": "Open course website" },
              "items": [
                { "type": "TextBlock", "text": "${title}", "weight": "Bolder", "wrap": false },
                { "type": "TextBlock", "text": "${when}", "isSubtle": true, "size": "Small", "spacing": "None" }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "ActionSet",
                  "actions": [
                    { "type": "Action.Execute", "title": "Done", "verb": "done:${id}", "tooltip": "Tick this course off" }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    { "type": "Action.Execute", "title": "Open tracker", "verb": "open" }
  ]
}
